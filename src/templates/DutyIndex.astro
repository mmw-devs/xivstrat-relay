---
// DutyIndex.astro — 副本首页预览模板
// 模拟 xivstrat 的 DutyHomeLayout + CollapsibleBox 外观

export interface Reference {
  url: string
  label: string
  embed?: string
}

export interface ThanksOther {
  type: string
  label: string
  link?: string
}

export interface Thanks {
  groupList: string[]
  devList: string[]
  other?: ThanksOther[]
}

export interface Waymark {
  href: string
  img: string
  downloadLabel?: string
  pageNumber?: number
  slotStart?: number
  slotEnd?: number
}

export interface Props {
  duty: {
    dutyId: string
    meta: {
      cnName: string
      enName: string
      videoLink?: string
    }
    cheatsheet?: string
    waymark?: Waymark
    macro?: string
    timeline?: string
    references?: Reference[]
    thanks?: Thanks
  }
  phases: Array<{ id: string; title: string }>
}

const { duty, phases } = Astro.props
const { meta, cheatsheet, waymark, macro, timeline, references, thanks } = duty
---

<div class="space-y-8">
  <!-- 标题区 -->
  <header class="border-b border-slate-700 pb-6">
    <h1 class="text-3xl font-bold text-white">{meta.cnName}</h1>
    <p class="mt-1 text-slate-400">{meta.enName}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      <!-- 阶段导航按钮 -->
      {
        phases.map((p) => (
          <a
            href={`/preview/${duty.dutyId}/${p.id}`}
            class="inline-flex items-center rounded-lg border border-purple-400 bg-purple-500 px-4 py-2 text-sm font-medium text-white hover:bg-purple-600 transition-colors"
          >
            <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            {p.title}
          </a>
        ))
      }
      {
        meta.videoLink && (
          <a
            href={meta.videoLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-blue-400 bg-blue-500 px-4 py-2 text-sm font-medium text-white hover:bg-blue-600 transition-colors"
          >
            <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 01-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 01.16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.13-.786 1.894v7.52c.017.764.28 1.396.786 1.894.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.13.786-1.894v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373l2.88 2.773c.213.25.32.551.32.907 0 .356-.107.658-.32.907l-2.88 2.773c-.249.25-.56.374-.933.374a1.29 1.29 0 01-.933-.4 1.148 1.148 0 01-.4-.907V12.387c0-.356.133-.658.4-.907.267-.249.578-.373.933-.373z"/>
            </svg>
            跳转视频攻略
          </a>
        )
      }
    </div>
  </header>

  <!-- 速查表 -->
  {
    cheatsheet && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="font-semibold text-white">小抄速览</span>
        </div>
        <div class="p-5">
          <div class="rounded-lg bg-slate-700/50 p-4 text-center text-slate-400 text-sm">
            📷 {cheatsheet}
          </div>
        </div>
      </section>
    )
  }

  <!-- 场地标点 -->
  {
    waymark && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="font-semibold text-white">场地标点</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-3 rounded-lg bg-slate-700/50 p-4">
            <svg class="h-8 w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <div>
              <p class="text-sm text-white">{waymark.downloadLabel || '下载标点文件'}</p>
              <p class="text-xs text-slate-400">{waymark.href}</p>
              {waymark.pageNumber && (
                <p class="text-xs text-slate-500">页码 {waymark.pageNumber}，槽位 {waymark.slotStart}-{waymark.slotEnd}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 宏 -->
  {
    macro && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span class="font-semibold text-white">宏</span>
        </div>
        <div class="p-5">
          <pre class="whitespace-pre-wrap rounded-lg bg-slate-900 p-4 text-sm text-slate-300 font-mono leading-relaxed">{macro}</pre>
        </div>
      </section>
    )
  }

  <!-- 简易时间轴 -->
  {
    timeline && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-semibold text-white">简易时间轴</span>
        </div>
        <div class="p-5">
          <div class="rounded-lg bg-slate-700/50 p-4 text-center text-slate-400 text-sm">
            📷 {timeline}
          </div>
        </div>
      </section>
    )
  }

  <!-- 参考资料 -->
  {
    references && references.length > 0 && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="font-semibold text-white">参考资料</span>
        </div>
        <div class="p-5">
          <ul class="space-y-2">
            {references.map((ref) => (
              <li>
                <a
                  href={ref.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-slate-700/50 hover:text-white transition-colors"
                >
                  <svg class="h-4 w-4 flex-shrink-0 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                  {ref.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 鸣谢 -->
  {
    thanks && (
      <section class="rounded-xl border border-slate-700 bg-slate-800/50 overflow-hidden">
        <div class="flex items-center gap-2 border-b border-slate-700 px-5 py-3">
          <svg class="h-5 w-5 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="font-semibold text-white">鸣谢</span>
        </div>
        <div class="p-5 space-y-4">
          {thanks.groupList && thanks.groupList.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-slate-500 mb-2">攻略组</p>
              <div class="flex flex-wrap gap-2">
                {thanks.groupList.map((g) => (
                  <span class="rounded-full bg-purple-500/20 px-3 py-1 text-xs text-purple-300">{g}</span>
                ))}
              </div>
            </div>
          )}
          {thanks.devList && thanks.devList.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-slate-500 mb-2">开发者</p>
              <div class="flex flex-wrap gap-2">
                {thanks.devList.map((d) => (
                  <span class="rounded-full bg-cyan-500/20 px-3 py-1 text-xs text-cyan-300">{d}</span>
                ))}
              </div>
            </div>
          )}
          {thanks.other && thanks.other.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-slate-500 mb-2">其他贡献</p>
              <div class="space-y-1">
                {thanks.other.map((o) => (
                  <p class="text-sm text-slate-400">
                    <span class="text-slate-500">{o.type}：</span>
                    {o.link ? (
                      <a href={o.link} target="_blank" rel="noopener" class="text-blue-400 hover:underline">{o.label}</a>
                    ) : (
                      <span>{o.label}</span>
                    )}
                  </p>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
</div>
